{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Unidle design tokens (W3C DTCG format). Stack-agnostic: convert with Style Dictionary or read directly.",
  "color": {
    "palette": {
      "neutral": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "50":  { "$type": "color", "$value": "#F6F7F9" },
        "100": { "$type": "color", "$value": "#ECEEF2" },
        "200": { "$type": "color", "$value": "#D9DDE4" },
        "400": { "$type": "color", "$value": "#9AA2AF" },
        "500": { "$type": "color", "$value": "#5F6672" },
        "600": { "$type": "color", "$value": "#4B525D" },
        "800": { "$type": "color", "$value": "#23272E" },
        "850": { "$type": "color", "$value": "#1B1E24" },
        "900": { "$type": "color", "$value": "#14161A" },
        "950": { "$type": "color", "$value": "#0E0F12" }
      },
      "green": {
        "300": { "$type": "color", "$value": "#5EE0A0" },
        "500": { "$type": "color", "$value": "#16A86A" },
        "600": { "$type": "color", "$value": "#0B7A4B" },
        "900": { "$type": "color", "$value": "#0B3B27" }
      },
      "amber": {
        "400": { "$type": "color", "$value": "#F5B13D" },
        "600": { "$type": "color", "$value": "#9A6200" }
      },
      "red": {
        "400": { "$type": "color", "$value": "#F27466" },
        "600": { "$type": "color", "$value": "#C8372B" }
      },
      "blue": {
        "400": { "$type": "color", "$value": "#6AA8FF" },
        "600": { "$type": "color", "$value": "#2563C9" }
      }
    },
    "light": {
      "bg":             { "$type": "color", "$value": "{color.palette.neutral.50}" },
      "surface":        { "$type": "color", "$value": "{color.palette.neutral.0}" },
      "surface-muted":  { "$type": "color", "$value": "{color.palette.neutral.100}" },
      "border":         { "$type": "color", "$value": "{color.palette.neutral.200}" },
      "text":           { "$type": "color", "$value": "{color.palette.neutral.900}" },
      "text-muted":     { "$type": "color", "$value": "{color.palette.neutral.500}" },
      "focus":          { "$type": "color", "$value": "{color.palette.blue.600}" },
      "toggle-off-track": { "$type": "color", "$value": "{color.palette.neutral.200}" },
      "toggle-off-thumb": { "$type": "color", "$value": "{color.palette.neutral.0}" },
      "toggle-off-border": { "$type": "color", "$value": "{color.palette.neutral.500}" },
      "on-accent": { "$type": "color", "$value": "{color.palette.neutral.0}" },
      "toggle-on-track":  { "$type": "color", "$value": "{color.palette.green.600}" },
      "toggle-on-thumb":  { "$type": "color", "$value": "{color.palette.neutral.0}" },
      "status-active":  { "$type": "color", "$value": "{color.palette.green.600}" },
      "status-idle":    { "$type": "color", "$value": "{color.palette.neutral.500}" },
      "status-warning": { "$type": "color", "$value": "{color.palette.amber.600}" },
      "status-error":   { "$type": "color", "$value": "{color.palette.red.600}" },
      "status-scheduled": { "$type": "color", "$value": "{color.palette.blue.600}" }
    },
    "dark": {
      "bg":             { "$type": "color", "$value": "{color.palette.neutral.950}" },
      "surface":        { "$type": "color", "$value": "{color.palette.neutral.900}" },
      "surface-muted":  { "$type": "color", "$value": "{color.palette.neutral.850}" },
      "border":         { "$type": "color", "$value": "{color.palette.neutral.800}" },
      "text":           { "$type": "color", "$value": "{color.palette.neutral.50}" },
      "text-muted":     { "$type": "color", "$value": "{color.palette.neutral.400}" },
      "focus":          { "$type": "color", "$value": "{color.palette.blue.400}" },
      "toggle-off-track": { "$type": "color", "$value": "{color.palette.neutral.800}" },
      "toggle-off-thumb": { "$type": "color", "$value": "{color.palette.neutral.400}" },
      "toggle-off-border": { "$type": "color", "$value": "{color.palette.neutral.400}" },
      "on-accent": { "$type": "color", "$value": "{color.palette.neutral.950}" },
      "toggle-on-track":  { "$type": "color", "$value": "{color.palette.green.500}" },
      "toggle-on-thumb":  { "$type": "color", "$value": "{color.palette.neutral.0}" },
      "status-active":  { "$type": "color", "$value": "{color.palette.green.300}" },
      "status-idle":    { "$type": "color", "$value": "{color.palette.neutral.400}" },
      "status-warning": { "$type": "color", "$value": "{color.palette.amber.400}" },
      "status-error":   { "$type": "color", "$value": "{color.palette.red.400}" },
      "status-scheduled": { "$type": "color", "$value": "{color.palette.blue.400}" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Ubuntu", "Cantarell", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SF Mono", "Cascadia Mono", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "body":    { "$type": "dimension", "$value": "14px" },
      "label":   { "$type": "dimension", "$value": "15px" },
      "title":   { "$type": "dimension", "$value": "20px" },
      "display": { "$type": "dimension", "$value": "28px" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "lineHeight": {
      "tight":  { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.45 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "14px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "card":  { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#0000001A" } },
    "thumb": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#00000040" } }
  },
  "motion": {
    "duration": {
      "fast":  { "$type": "duration", "$value": "120ms" },
      "base":  { "$type": "duration", "$value": "180ms" },
      "pulse": { "$type": "duration", "$value": "2000ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "size": {
    "window": {
      "width":  { "$type": "dimension", "$value": "360px" },
      "height": { "$type": "dimension", "$value": "420px" }
    },
    "toggle": {
      "width":  { "$type": "dimension", "$value": "88px" },
      "height": { "$type": "dimension", "$value": "48px" },
      "thumb":  { "$type": "dimension", "$value": "40px" }
    },
    "hitTarget": { "$type": "dimension", "$value": "44px" },
    "trayIcon":  { "$type": "dimension", "$value": "16px" }
  }
}
