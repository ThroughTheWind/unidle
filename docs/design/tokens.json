{
  "$description": "Unidle design tokens (W3C DTCG format). Stack-agnostic: convert with Style Dictionary or read directly.",
  "color": {
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#EEF1F0",
        "$description": "Page/desktop behind the window; previews' ground."
      },
      "surface": {
        "$type": "color",
        "$value": "#FBFCFB",
        "$description": "Window surface, top of its vertical gradient."
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "#F1F4F3",
        "$description": "Window surface, bottom of its gradient; inputs."
      },
      "border": {
        "$type": "color",
        "$value": "#D5DBD8",
        "$description": "Hairlines, 1px rings around raised faces (decorative)."
      },
      "text": {
        "$type": "color",
        "$value": "#0F1513",
        "$description": "Primary text on any surface."
      },
      "text-muted": {
        "$type": "color",
        "$value": "#5A6561",
        "$description": "Secondary text, state word when off, hints. 4.5:1+ on bg, surface and power-off-face."
      },
      "focus": {
        "$type": "color",
        "$value": "#2563C9",
        "$description": "2px focus ring."
      },
      "power-on": {
        "$type": "color",
        "$value": "#08774F",
        "$description": "Power button ON fill (gradient end); ON state word. The brand green."
      },
      "power-on-hi": {
        "$type": "color",
        "$value": "#14A06C",
        "$description": "Power button ON fill (gradient start, top-left)."
      },
      "power-glow": {
        "$type": "color",
        "$value": "#1FD592",
        "$description": "Glow, ripples, orbit comet and window bloom while ON. Never for text."
      },
      "power-off-face": {
        "$type": "color",
        "$value": "#E6EAE8",
        "$description": "Power button face when OFF (matte)."
      },
      "power-off-ink": {
        "$type": "color",
        "$value": "#5A6561",
        "$description": "Glyph on the OFF face."
      },
      "on-accent": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Glyph and text on power-on fills."
      },
      "status-active": {
        "$type": "color",
        "$value": "#08774F",
        "$description": "Running: status dot and text."
      },
      "status-idle": {
        "$type": "color",
        "$value": "#5A6561",
        "$description": "Stopped."
      },
      "status-scheduled": {
        "$type": "color",
        "$value": "#2563C9",
        "$description": "Reserved for the future scheduled state; never for ON."
      },
      "status-warning": {
        "$type": "color",
        "$value": "#8F5C00",
        "$description": "Needs attention, e.g. missing OS permission."
      },
      "status-error": {
        "$type": "color",
        "$value": "#C8372B",
        "$description": "Simulation failed."
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "#07090A"
      },
      "surface": {
        "$type": "color",
        "$value": "#111614"
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "#0B0F0E"
      },
      "border": {
        "$type": "color",
        "$value": "#1C2321"
      },
      "text": {
        "$type": "color",
        "$value": "#EEF3F1"
      },
      "text-muted": {
        "$type": "color",
        "$value": "#93A09B"
      },
      "focus": {
        "$type": "color",
        "$value": "#6AA8FF"
      },
      "power-on": {
        "$type": "color",
        "$value": "#17B47A"
      },
      "power-on-hi": {
        "$type": "color",
        "$value": "#34D697"
      },
      "power-glow": {
        "$type": "color",
        "$value": "#3EF0A8"
      },
      "power-off-face": {
        "$type": "color",
        "$value": "#1A211F"
      },
      "power-off-ink": {
        "$type": "color",
        "$value": "#93A09B"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#04110B"
      },
      "status-active": {
        "$type": "color",
        "$value": "#5EE0A0"
      },
      "status-idle": {
        "$type": "color",
        "$value": "#93A09B"
      },
      "status-scheduled": {
        "$type": "color",
        "$value": "#6AA8FF"
      },
      "status-warning": {
        "$type": "color",
        "$value": "#F5B13D"
      },
      "status-error": {
        "$type": "color",
        "$value": "#F27466"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Geist",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Ubuntu",
          "Cantarell",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SF Mono",
          "Cascadia Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "12px"
      },
      "body": {
        "$type": "dimension",
        "$value": "14px"
      },
      "label": {
        "$type": "dimension",
        "$value": "15px"
      },
      "title": {
        "$type": "dimension",
        "$value": "20px"
      },
      "display": {
        "$type": "dimension",
        "$value": "28px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      }
    },
    "tracking": {
      "state": {
        "$type": "dimension",
        "$value": "0.16em"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "14px"
    },
    "window": {
      "$type": "dimension",
      "$value": "22px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "light": {
      "window": {
        "$type": "string",
        "$value": "0 1px 0 #FFFFFF inset, 0 24px 48px -24px #0F15132E, 0 2px 6px #0F151314"
      },
      "face": {
        "$type": "string",
        "$value": "inset 0 2px 1px #FFFFFF40, inset 0 -6px 14px #00000014, 0 14px 28px -10px #00000040"
      },
      "knob": {
        "$type": "string",
        "$value": "0 6px 14px -4px #00000055, 0 1px 0 #FFFFFF inset"
      }
    },
    "dark": {
      "window": {
        "$type": "string",
        "$value": "0 1px 0 #FFFFFF12 inset, 0 30px 60px -20px #000000B3, 0 0 0 1px #FFFFFF0A"
      },
      "face": {
        "$type": "string",
        "$value": "inset 0 2px 1px #FFFFFF30, inset 0 -6px 14px #00000040, 0 14px 28px -10px #000000A0"
      },
      "knob": {
        "$type": "string",
        "$value": "0 6px 14px -4px #000000AA, 0 1px 0 #FFFFFF inset"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "180ms"
      },
      "fill": {
        "$type": "duration",
        "$value": "500ms"
      },
      "breathe": {
        "$type": "duration",
        "$value": "3200ms"
      },
      "orbit": {
        "$type": "duration",
        "$value": "2600ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "spring": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          1.4,
          0.5,
          1
        ]
      }
    }
  },
  "size": {
    "window-width": {
      "$type": "dimension",
      "$value": "360px"
    },
    "window-height": {
      "$type": "dimension",
      "$value": "420px"
    },
    "halo-size": {
      "$type": "dimension",
      "$value": "172px"
    },
    "orbit-size": {
      "$type": "dimension",
      "$value": "196px"
    },
    "pulse-width": {
      "$type": "dimension",
      "$value": "236px"
    },
    "pulse-height": {
      "$type": "dimension",
      "$value": "104px"
    },
    "eye-size": {
      "$type": "dimension",
      "$value": "176px"
    },
    "hit-target": {
      "$type": "dimension",
      "$value": "44px"
    },
    "tray-icon": {
      "$type": "dimension",
      "$value": "16px"
    }
  },
  "powerButton": {
    "$description": "User-selectable power button style. Default is halo.",
    "default": {
      "$type": "string",
      "$value": "halo"
    },
    "styles": {
      "$type": "string",
      "$value": "halo | orbit | pulse | eye"
    }
  }
}